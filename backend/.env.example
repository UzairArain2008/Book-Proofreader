# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Database
DATABASE_URL=sqlite:///./storage/proofreader.db

# Uploads
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_PAGES=3

# Rendering
PAGE_RENDER_DPI=200

# Storage / privacy
DELETE_TEMP_FILES=true
STORAGE_DIR=./storage

# CORS
FRONTEND_ORIGIN=http://localhost:3000
